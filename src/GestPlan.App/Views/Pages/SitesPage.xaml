<Page x:Class="GestPlan.App.Views.Pages.SitesPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:loc="clr-namespace:GestPlan.App.Services"
         d:DataContext="{d:DesignInstance Type=viewModels:SitesViewModel}"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:viewModels="clr-namespace:GestPlan.App.ViewModels"
         mc:Ignorable="d"
         Title="{loc:Localisation Cle=Page.Sites.Titre}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <ui:TextBlock Text="{loc:Localisation Cle=Page.Sites.Titre}" FontTypography="TitleLarge" Margin="0,0,0,12" />

            <ListView ItemsSource="{Binding Sites}" MaxHeight="500">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="{Binding Nom}" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Ville}" Opacity="0.7" FontTypography="Caption" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="{loc:Localisation Cle=Page.Sites.Modifier}"
                                           Appearance="Secondary" Margin="4,0"
                                           Command="{Binding DataContext.ModifierSiteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />

                                <ui:Button Grid.Column="2"
                                           Appearance="Danger" Margin="4,0"
                                           Command="{Binding DataContext.BasculerActivationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstActif}" Value="True">
                                                    <Setter Property="Content" Value="{loc:Localisation Cle=Page.Sites.Supprimer}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstActif}" Value="False">
                                                    <Setter Property="Content" Value="{loc:Localisation Cle=Page.Sites.Reactiver}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                                <ui:Button Grid.Column="3"
                                           Content="{loc:Localisation Cle=Page.Sites.SelectionnerCommeGlobal}"
                                           Appearance="Primary" Margin="4,0"
                                           Command="{Binding DataContext.SelectionnerSiteGlobalCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <ui:TextBlock Text="{loc:Localisation Cle=Page.Sites.Nouveau}" FontTypography="BodyStrong" Margin="0,0,0,12" />

            <ui:TextBox Text="{Binding SiteEnCoursEdition.Nom, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Localisation Cle=Page.Sites.Nom}" Margin="0,0,0,8" />
            <ui:TextBox Text="{Binding SiteEnCoursEdition.Adresse, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Localisation Cle=Page.Sites.Adresse}" Margin="0,0,0,8" />
            <ui:TextBox Text="{Binding SiteEnCoursEdition.CodePostal, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Localisation Cle=Page.Sites.CodePostal}" Margin="0,0,0,8" />
            <ui:TextBox Text="{Binding SiteEnCoursEdition.Ville, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Localisation Cle=Page.Sites.Ville}" Margin="0,0,0,8" />
            <ui:TextBox Text="{Binding SiteEnCoursEdition.FuseauHoraire, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Localisation Cle=Page.Sites.FuseauHoraire}" Margin="0,0,0,8" />

            <CheckBox Content="{loc:Localisation Cle=Page.Sites.StatutActif}"
                      IsChecked="{Binding SiteEnCoursEdition.EstActif}" Margin="0,0,0,12" />

            <ui:Button Content="{loc:Localisation Cle=Page.Sites.Enregistrer}"
                       Appearance="Primary" HorizontalAlignment="Stretch"
                       Command="{Binding EnregistrerCommand}" />
            <ui:Button Content="{loc:Localisation Cle=Page.Sites.Nouveau}"
                       Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                       Command="{Binding PreparerNouveauSiteCommand}" />
        </StackPanel>
    </Grid>
</Page>
