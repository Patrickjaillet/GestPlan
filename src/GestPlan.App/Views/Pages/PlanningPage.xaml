<Page x:Class="GestPlan.App.Views.Pages.PlanningPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:loc="clr-namespace:GestPlan.App.Services"
         d:DataContext="{d:DesignInstance Type=viewModels:PlanningViewModel}"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:viewModels="clr-namespace:GestPlan.App.ViewModels"
         mc:Ignorable="d"
         Title="{loc:Localisation Cle=Page.Planning.Titre}">
    <Page.Resources>
        <loc:ChaineVersVisibiliteConverter x:Key="ChaineVersVisibilite" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" Text="{loc:Localisation Cle=Page.Planning.Titre}" FontTypography="TitleLarge" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox SelectedItem="{Binding VueSelectionnee}" Width="140" Margin="0,0,12,0">
                <ComboBox.ItemsSource>
                    <x:Array Type="{x:Type viewModels:TypeVuePlanning}">
                        <viewModels:TypeVuePlanning>Semaine</viewModels:TypeVuePlanning>
                        <viewModels:TypeVuePlanning>Mois</viewModels:TypeVuePlanning>
                        <viewModels:TypeVuePlanning>ParEmploye</viewModels:TypeVuePlanning>
                        <viewModels:TypeVuePlanning>ParPoste</viewModels:TypeVuePlanning>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>

            <ui:Button Content="{loc:Localisation Cle=Page.Planning.SemainePrecedente}" Appearance="Secondary" Margin="0,0,4,0"
                       Command="{Binding SemainePrecedenteCommand}" />
            <ui:Button Content="{loc:Localisation Cle=Page.Planning.AujourdHui}" Appearance="Secondary" Margin="0,0,4,0"
                       Command="{Binding AujourdHuiCommand}" />
            <ui:Button Content="{loc:Localisation Cle=Page.Planning.SemaineSuivante}" Appearance="Secondary" Margin="0,0,20,0"
                       Command="{Binding SemaineSuivanteCommand}" />

            <ui:Button Content="{loc:Localisation Cle=Page.Planning.Annuler}" Appearance="Secondary" Margin="0,0,4,0"
                       IsEnabled="{Binding PeutAnnuler}" Command="{Binding AnnulerCommand}" />
            <ui:Button Content="{loc:Localisation Cle=Page.Planning.Retablir}" Appearance="Secondary" Margin="0,0,20,0"
                       IsEnabled="{Binding PeutRetablir}" Command="{Binding RetablirCommand}" />

            <ui:Button Content="{loc:Localisation Cle=Page.Planning.Publier}" Appearance="Primary" Margin="0,0,4,0"
                       Command="{Binding PublierSemaineCommand}" />
            <ui:Button Content="{loc:Localisation Cle=Page.Planning.Dupliquer}" Appearance="Secondary"
                       Click="DupliquerSemaine_Click" />
        </StackPanel>

        <ui:TextBlock Grid.Row="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                      Text="{Binding MessageErreur}" Visibility="{Binding MessageErreur, Converter={StaticResource ChaineVersVisibilite}}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConteneurSections" />
        </ScrollViewer>
    </Grid>
</Page>
