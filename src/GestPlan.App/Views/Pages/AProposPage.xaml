<Page x:Class="GestPlan.App.Views.Pages.AProposPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:loc="clr-namespace:GestPlan.App.Services"
         d:DataContext="{d:DesignInstance Type=viewModels:AProposViewModel}"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:viewModels="clr-namespace:GestPlan.App.ViewModels"
         mc:Ignorable="d"
         Title="{loc:Localisation Cle=Page.APropos.Titre}">
    <StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="/Assets/logo.png" Width="96" Height="96" Margin="0,0,0,16" />
        <ui:TextBlock Text="{loc:Localisation Cle=Page.APropos.NomLogiciel}" FontTypography="TitleLarge" HorizontalAlignment="Center" />
        <ui:TextBlock Text="{loc:Localisation Cle=Page.APropos.Copyright}" Margin="0,12,0,0" Opacity="0.7" HorizontalAlignment="Center" />
        <ui:TextBlock Text="{loc:Localisation Cle=Page.APropos.Email}" Margin="0,4,0,0" Opacity="0.7" HorizontalAlignment="Center" />
        <ui:TextBlock Text="{loc:Localisation Cle=Page.APropos.SiteWeb}" Margin="0,4,0,0" Opacity="0.7" HorizontalAlignment="Center" />
    </StackPanel>
</Page>
