<Page x:Class="GestPlan.App.Views.Pages.RapportsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:loc="clr-namespace:GestPlan.App.Services"
         d:DataContext="{d:DesignInstance Type=viewModels:RapportsViewModel}"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:viewModels="clr-namespace:GestPlan.App.ViewModels"
         mc:Ignorable="d"
         Title="{loc:Localisation Cle=Page.Rapports.Titre}">
    <Page.Resources>
        <loc:ChaineVersVisibiliteConverter x:Key="ChaineVersVisibilite" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" Text="{loc:Localisation Cle=Page.Rapports.TitreConformite}" FontTypography="TitleLarge" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding SiteSelectionne}"
                      DisplayMemberPath="Nom" Width="200" Margin="0,0,12,0" />

            <DatePicker SelectedDate="{Binding DebutPeriode}" Width="140" Margin="0,0,8,0" />
            <ui:TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding FinPeriode}" Width="140" Margin="0,0,16,0" />

            <ui:Button Content="{loc:Localisation Cle=Page.Rapports.Actualiser}" Appearance="Secondary"
                       Margin="0,0,12,0" Command="{Binding GenererRapportCommand}" />

            <ui:Button Content="{loc:Localisation Cle=Page.Rapports.ExporterPdf}" Appearance="Primary"
                       Click="ExporterPdf_Click" />
        </StackPanel>

        <ui:TextBlock Grid.Row="1" Text="{Binding MessageErreur}"
                      Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                      TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Visibility="{Binding MessageErreur, Converter={StaticResource ChaineVersVisibilite}}" />

        <Grid Grid.Row="2">
            <ui:TextBlock Text="{loc:Localisation Cle=Page.Rapports.AucuneAnomalie}" Opacity="0.7"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                <ui:TextBlock.Style>
                    <Style TargetType="ui:TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anomalies.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:TextBlock.Style>
            </ui:TextBlock>

            <ListView ItemsSource="{Binding Anomalies}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{loc:Localisation Cle=Page.Rapports.Employe}" DisplayMemberBinding="{Binding NomEmploye}" Width="220" />
                        <GridViewColumn Header="{loc:Localisation Cle=Page.Rapports.Date}" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Localisation Cle=Page.Rapports.Anomalie}" DisplayMemberBinding="{Binding Libelle}" Width="380" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Page>
