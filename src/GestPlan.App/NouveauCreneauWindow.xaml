<ui:FluentWindow x:Class="GestPlan.App.NouveauCreneauWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:GestPlan.App.Services"
                 mc:Ignorable="d"
                 Title="{loc:Localisation Cle=Page.Planning.NouveauCreneau}"
                 Icon="/Assets/logo.png"
                 Language="fr-FR"
                 Height="440" Width="360"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <loc:ChaineVersVisibiliteConverter x:Key="ChaineVersVisibilite" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="GestPlan" Grid.Row="0" Icon="{ui:ImageIcon 'pack://application:,,,/Assets/logo.png'}" />

        <StackPanel Grid.Row="1" Margin="24">
            <ComboBox x:Name="ListeEmployes" DisplayMemberPath="Nom" Margin="0,0,0,8" />
            <ComboBox x:Name="ListePostes" DisplayMemberPath="Nom" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:TextBlock Text="{loc:Localisation Cle=Page.Planning.HeureDebut}" Width="130" VerticalAlignment="Center" />
                <ui:TimePicker x:Name="SelecteurHeureDebut" Width="150" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBlock Text="{loc:Localisation Cle=Page.Planning.HeureFin}" Width="130" VerticalAlignment="Center" />
                <ui:TimePicker x:Name="SelecteurHeureFin" Width="150" />
            </StackPanel>

            <ui:TextBlock x:Name="MessageErreurTexte" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

            <ui:Button Content="{loc:Localisation Cle=Page.Planning.Creer}" Appearance="Primary"
                       HorizontalAlignment="Stretch" Click="Creer_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
