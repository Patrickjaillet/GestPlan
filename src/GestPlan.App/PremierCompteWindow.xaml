<ui:FluentWindow x:Class="GestPlan.App.PremierCompteWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:GestPlan.App.Services"
                 xmlns:viewModels="clr-namespace:GestPlan.App.ViewModels"
                 d:DataContext="{d:DesignInstance Type=viewModels:PremierCompteViewModel}"
                 mc:Ignorable="d"
                 Title="{loc:Localisation Cle=PremierCompte.Titre}"
                 Icon="/Assets/logo.png"
                 Language="fr-FR"
                 Height="480" Width="400"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <loc:ChaineVersVisibiliteConverter x:Key="ChaineVersVisibilite" />
        <loc:BooleenInverseConverter x:Key="BooleenInverse" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="GestPlan" Grid.Row="0" Icon="{ui:ImageIcon 'pack://application:,,,/Assets/logo.png'}" />

        <StackPanel Grid.Row="1" Margin="32" VerticalAlignment="Center">
            <ui:TextBlock Text="{loc:Localisation Cle=PremierCompte.Titre}" FontTypography="Title" TextWrapping="Wrap"
                          Margin="0,0,0,8" HorizontalAlignment="Center" TextAlignment="Center" />
            <ui:TextBlock Text="{loc:Localisation Cle=PremierCompte.Message}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,20" TextAlignment="Center" />

            <ui:TextBox Text="{Binding NomUtilisateur, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Localisation Cle=PremierCompte.NomUtilisateur}" Margin="0,0,0,12" />

            <ui:PasswordBox Password="{Binding MotDePasse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{loc:Localisation Cle=PremierCompte.MotDePasse}" Margin="0,0,0,12" />

            <ui:PasswordBox Password="{Binding ConfirmationMotDePasse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{loc:Localisation Cle=PremierCompte.ConfirmationMotDePasse}" Margin="0,0,0,12" />

            <ui:TextBlock Text="{Binding MessageErreur}"
                          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          TextWrapping="Wrap" Margin="0,0,0,12"
                          Visibility="{Binding MessageErreur, Converter={StaticResource ChaineVersVisibilite}}" />

            <ui:Button Content="{loc:Localisation Cle=PremierCompte.Creer}"
                       Appearance="Primary" HorizontalAlignment="Stretch"
                       IsEnabled="{Binding CreationEnCours, Converter={StaticResource BooleenInverse}}"
                       Command="{Binding CreerCommand}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
